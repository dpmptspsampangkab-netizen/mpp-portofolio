---
import Base from '../../layouts/Base.astro';
---
<Base title="Berita" description="Berita dan pengumuman Mal Pelayanan Publik.">
  <div class="wrap" id="konten"><p class="meta">Memuat…</p></div>
  <script>
    import { muatData, esc, tanggalIndo, paragraf, pesanGagal } from '../../lib/data';

    const id = new URLSearchParams(location.search).get('id') ?? '';
    const isi = document.getElementById('konten')!;
    const kembali = '<a class="btn alt" href="/berita">← Semua berita</a>';

    muatData(
      (d, segar) => {
        const b = d.berita.find((x) => x.id === id);
        if (!b) {
          if (segar) isi.innerHTML = `<div class="page-head"><h1>Berita tidak ditemukan</h1></div><div class="row">${kembali}</div>`;
          return;
        }
        document.title = `${b.judul} — ${d.situs.nama}`;
        const gambar = /^https?:\/\//i.test(b.gambar)
          ? `<img src="${esc(b.gambar)}" alt="" class="foto" />`
          : '';
        isi.innerHTML = `
          <div class="page-head"><span class="meta">${esc(tanggalIndo(b.tanggal))}</span><h1>${esc(b.judul)}</h1></div>
          <article class="card artikel">${gambar}<div class="prose">${paragraf(b.isi || b.ringkas)}</div></article>
          <div class="row">${kembali}</div>`;
      },
      () => { isi.innerHTML = pesanGagal; },
    );
  </script>
</Base>
