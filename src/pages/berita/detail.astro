---
import Base from '../../layouts/Base.astro';
---
<Base title="Berita">
  <div class="wrap">
    <article class="baca" id="baca"><p class="meta">Memuat…</p></article>
    <p class="row"><a class="btn alt" href="/berita">← Semua berita</a></p>
  </div>
</Base>

<script>
  import { muatData, esc, tanggalIndo, pesanGagal } from '../../lib/data';

  const el = (id: string) => document.getElementById(id)!;
  const id = new URLSearchParams(location.search).get('id') || '';

  // Satu baris di Sheets = satu paragraf.
  const paragraf = (t: string) =>
    String(t || '').split(/\r?\n+/).map((s) => s.trim()).filter(Boolean).map((s) => `<p>${esc(s)}</p>`).join('');

  muatData(
    (d) => {
      const b: any = d.berita.find((x: any) => String(x.id) === id);
      if (!b) {
        el('baca').innerHTML = '<h1>Berita tidak ditemukan</h1><p class="meta">Berita mungkin sudah dihapus atau tautannya keliru.</p>';
        return;
      }
      const gb = String(b.gambar || '').trim();
      const isi = b.isi ?? b.konten ?? b.ringkas ?? '';
      document.title = `${b.judul} | ${d.situs.nama}`;
      el('baca').innerHTML =
        `<time class="meta">${esc(tanggalIndo(b.tanggal))}</time><h1>${esc(b.judul)}</h1>` +
        (gb ? `<img class="foto" src="${esc(gb)}" alt="" onerror="this.remove()" />` : '') +
        `<div class="isi-teks">${paragraf(isi)}</div>`;
    },
    () => { el('baca').innerHTML = pesanGagal; },
  );
</script>
