---
import Base from '../../layouts/Base.astro';
---
<Base title="Berita" description="Berita dan pengumuman Mal Pelayanan Publik.">
  <div class="wrap prose" id="isi"><p class="meta">Memuat…</p></div>
  <script>
    import { muatData, esc, tanggalIndo, paragraf, pesanGagal } from '../../lib/data';

    const id = new URLSearchParams(location.search).get('id') ?? '';
    const isi = document.getElementById('isi')!;
    const kembali = '<p><a class="btn alt" href="/berita">← Semua berita</a></p>';

    muatData(
      (d, segar) => {
        const b = d.berita.find((x) => x.id === id);
        if (!b) {
          if (segar) isi.innerHTML = `<div class="page-head"><h1>Berita tidak ditemukan</h1></div>${kembali}`;
          return;
        }
        document.title = `${b.judul} — ${d.situs.nama}`;
        const gambar = /^https?:\/\//i.test(b.gambar)
          ? `<img src="${esc(b.gambar)}" alt="" style="max-width:100%;border-radius:12px;margin:12px 0" />`
          : '';
        isi.innerHTML = `
          <div class="page-head"><span class="meta">${esc(tanggalIndo(b.tanggal))}</span><h1>${esc(b.judul)}</h1></div>
          ${gambar}
          ${paragraf(b.isi || b.ringkas)}
          ${kembali}`;
      },
      () => { isi.innerHTML = pesanGagal; },
    );
  </script>
</Base>
