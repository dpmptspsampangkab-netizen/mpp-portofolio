---
import Base from '../layouts/Base.astro';
---
<Base title="Aturan">
  <div class="wrap">
    <section class="page-head">
      <h1>Aturan</h1>
      <p>Dasar hukum, standar pelayanan, dan dokumen resmi MPP. Lihat atau unduh dokumen yang Anda perlukan.</p>
    </section>

    <div class="chips" id="kat" role="tablist" aria-label="Kategori aturan"></div>
    <div class="tools">
      <input id="cari" type="search" placeholder="Cari judul atau nomor aturan…" aria-label="Cari aturan" />
      <span class="meta tools-n" id="jumlah" aria-live="polite"></span>
    </div>

    <div class="dt" role="table" aria-label="Daftar aturan">
      <div class="dt-head" role="row">
        <span role="columnheader">Dokumen</span>
        <span role="columnheader">Kategori</span>
        <span role="columnheader">Nomor</span>
        <span role="columnheader">Tahun</span>
        <span role="columnheader">Aksi</span>
      </div>
      <div id="daftar" role="rowgroup"><p class="meta dt-msg">Memuat…</p></div>
    </div>
    <p class="empty" id="kosong">Belum ada dokumen yang cocok.</p>
  </div>
</Base>

<script>
  import { esc } from '../lib/data';
  import { muatAturan, kategoriUrut, unduhUrl, aman } from '../lib/aturan';
  import type { Aturan } from '../lib/aturan';

  const el = (id: string) => document.getElementById(id)!;
  let semua: Aturan[] = [];
  let aktif = new URLSearchParams(location.search).get('k') || '';

  const svg = (isi: string, u = 20) => `<svg viewBox="0 0 24 24" width="${u}" height="${u}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${isi}</svg>`;
  const BERKAS = svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>', 22);
  const MATA = svg('<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>', 16);
  const UNDUH = svg('<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>', 16);

  function baris(a: Aturan): string {
    const lihat = aman(a.berkas);
    const aksi = lihat
      ? `<a class="dt-btn" href="${esc(lihat)}" target="_blank" rel="noopener">${MATA}<span>Lihat</span></a>` +
        `<a class="dt-btn unduh" href="${esc(unduhUrl(lihat))}" target="_blank" rel="noopener">${UNDUH}<span>Unduh</span></a>`
      : '<span class="dt-none">Berkas belum tersedia</span>';
    return `<div class="dt-row" role="row">` +
      `<div class="dt-doc" role="cell"><span class="dok-ico dt-ico">${BERKAS}</span>` +
      `<div class="dt-ttl"><strong>${esc(a.judul)}</strong>${a.keterangan ? `<small>${esc(a.keterangan)}</small>` : ''}</div></div>` +
      `<div class="dt-c dt-kat" role="cell"><span class="mtag">${esc(a.kategori)}</span></div>` +
      `<div class="dt-c" role="cell" data-l="Nomor">${esc(a.nomor || '-')}</div>` +
      `<div class="dt-c" role="cell" data-l="Tahun">${esc(a.tahun || '-')}</div>` +
      `<div class="dt-act" role="cell">${aksi}</div>` +
      `</div>`;
  }

  function tampil() {
    const kats = kategoriUrut(semua);
    if (aktif && !kats.includes(aktif)) aktif = '';
    el('kat').innerHTML = kats.length > 1
      ? ['', ...kats].map((k) => `<button type="button" role="tab" aria-selected="${k === aktif}" class="${k === aktif ? 'on' : ''}" data-k="${esc(k)}">${k ? esc(k) : 'Semua'}</button>`).join('')
      : '';
    const q = (el('cari') as HTMLInputElement).value.trim().toLowerCase();
    const hasil = semua
      .filter((a) => (!aktif || a.kategori === aktif) && (!q || `${a.judul} ${a.nomor} ${a.tahun} ${a.keterangan}`.toLowerCase().includes(q)))
      .sort((a, b) => a.urutan - b.urutan || String(b.tahun).localeCompare(String(a.tahun)) || a.judul.localeCompare(b.judul));
    el('daftar').innerHTML = hasil.map(baris).join('');
    el('kosong').style.display = hasil.length ? 'none' : 'block';
    el('jumlah').textContent = semua.length ? `${hasil.length} dokumen` : '';
  }

  muatAturan(
    (d) => { semua = d; tampil(); },
    true,
    () => { el('daftar').innerHTML = '<p class="meta dt-msg">Data belum bisa dimuat. Coba muat ulang halaman.</p>'; },
  );

  el('kat').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-k]') as HTMLElement | null;
    if (!b) return;
    aktif = b.dataset.k || '';
    history.replaceState(null, '', aktif ? `?k=${encodeURIComponent(aktif)}` : location.pathname);
    tampil();
  });
  el('cari').addEventListener('input', tampil);
</script>
