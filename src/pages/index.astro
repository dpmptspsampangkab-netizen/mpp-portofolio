---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import site from '../data/site.json';
const layanan = (await getCollection('layanan')).slice(0, 6);
const instansi = (await getCollection('instansi')).sort((a, b) => a.data.urutan - b.data.urutan);
const berita = (await getCollection('berita')).sort((a, b) => +b.data.tanggal - +a.data.tanggal).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('id-ID', { dateStyle: 'long' });
---
<Base>
  <div class="wrap">
    <section class="hero">
      <h1>{site.nama}<br />{site.daerah}</h1>
      <p>{site.tagline}</p>
      <div class="row"><a class="btn" href="/layanan">Cari layanan</a><a class="btn alt" href="/kontak">Lokasi &amp; jam layanan</a></div>
    </section>
    <section class="blk"><div class="grid">
      {site.capaian.map((c) => <div class="card stat"><b>{c.nilai.toLocaleString('id-ID')}{c.satuan ? ' ' + c.satuan : ''}</b><span>{c.label}</span></div>)}
    </div></section>
    <section class="blk"><h2>Layanan unggulan</h2><div class="grid">{layanan.map((l) => <ServiceCard {...l} />)}</div></section>
    <section class="blk"><h2>Instansi di MPP</h2><div class="grid">
      {instansi.map((i) => <div class="card"><h3>{i.data.nama}</h3><p>{i.data.loket}</p></div>)}
    </div></section>
    <section class="blk"><h2>Berita terbaru</h2><div class="grid">
      {berita.map((b) => <a class="card" href={`/berita/${b.id}`}><span class="meta">{fmt(b.data.tanggal)}</span><h3>{b.data.judul}</h3><p>{b.data.ringkas}</p></a>)}
    </div></section>
  </div>
</Base>
