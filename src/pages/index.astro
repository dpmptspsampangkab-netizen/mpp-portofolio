---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
// Kata terakhir nama / daerah tampil besar; kata sebelumnya kecil (gaya hero berfoto).
const bagi = (t: string) => { const k = String(t).trim().split(/\s+/); const b = k.pop() ?? ''; return [k.join(' '), b]; };
const [nk, nb] = bagi(site.nama);
const [dk, db] = bagi(site.daerah);
---
<Base>
  <div class="gbar" aria-hidden="true"></div>
  <div class="wrap">
    <section class="hero2" data-g="hero">
      <div class="deco" aria-hidden="true"><i class="d1"></i><i class="d2"></i><i class="d3"></i></div>
      <h1 class="h2-judul" id="h-judul">
        <span class="kiri"><small>{nk}</small> <b>{nb}</b></span>
        <span class="kanan"><small>{dk}</small> <b>{db}</b></span>
      </h1>
      <img class="h2-foto" src="/hero/petugas.webp" alt="Petugas MPP menyambut pengunjung dengan ramah" width="900" height="1146" fetchpriority="high" decoding="async" />
      <div class="h2-panel">
        <div class="h2-kiri">
          <p class="h2-eyebrow"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"/></svg>Selamat datang</p>
          <p class="h2-tagline" id="h-tagline">{site.tagline}</p>
          <div class="row"><a class="btn" href="/layanan">Cari layanan</a><a class="btn alt" href="/kontak">Lokasi &amp; jam layanan</a><a class="btn line" id="b-aduan" href="/kontak">Pengaduan</a></div>
          <div class="sebaran" id="sebaran"></div>
        </div>
        <aside class="h2-jam" id="jam" aria-label="Jam layanan"><h3>Jam layanan</h3><p class="meta">Memuat…</p></aside>
      </div>
    </section>
    <section class="blk"><div class="kpis" id="capaian"></div></section>
    <section class="blk"><div class="panel pn-split" data-g>
      <i class="pn-blob" data-par aria-hidden="true"></i>
      <img class="pn-foto" data-par src="/hero/petugas-layanan.webp" alt="Petugas MPP mempersilakan memilih layanan" width="1000" height="805" loading="lazy" decoding="async" />
      <div class="pn-isi">
        <h2>Layanan unggulan</h2><p class="sub">Klik layanan untuk melihat syarat dan alurnya.</p>
        <div class="tiles" id="layanan"><p class="meta">Memuat…</p></div>
      </div>
    </div></section>
    <section class="blk"><div class="panel pn-split pn-kanan" data-g>
      <i class="pn-blob" data-par aria-hidden="true"></i>
      <img class="pn-foto" data-par src="/hero/petugas-instansi.webp" alt="Petugas MPP membantu lewat tablet" width="900" height="966" loading="lazy" decoding="async" />
      <div class="pn-isi">
        <h2>Instansi di MPP</h2><p class="sub">Instansi yang melayani di Mal Pelayanan Publik.</p>
        <div class="tiles" id="instansi"></div>
      </div>
    </div></section>
    <section class="blk"><div class="head-row"><h2>Berita terbaru</h2><a class="more" href="/berita">Semua berita</a></div><div class="nw-grid" id="berita"></div></section>
  </div>
</Base>

<script>
  import { muatData, esc, tanggalIndo, pesanGagal } from '../lib/data';
  import type { Data } from '../lib/data';
  import { mulaiGulir } from '../lib/gulir';

  const el = (id: string) => document.getElementById(id)!;

  const ikon = (d: string) =>
    `<span class="ico"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg></span>`;
  const IKON_DOK = ikon('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>');
  const IKON_GEDUNG = ikon('<path d="M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16M15 9h4a1 1 0 0 1 1 1v11M2 21h20M8 8h3M8 12h3M8 16h3"/>');

  // Bilah pil: sebaran layanan per kategori (dihitung dari data nyata).
  function sebaran(d: Data): string {
    const total = d.layanan.length;
    if (!total) return '';
    const hitung = new Map<string, number>();
    d.layanan.forEach((l) => hitung.set(l.kategori, (hitung.get(l.kategori) ?? 0) + 1));
    const urut = [...hitung.entries()].sort((a, b) => b[1] - a[1]);
    const atas = urut.slice(0, 3);
    const sisa = urut.slice(3).reduce((s, [, n]) => s + n, 0);
    if (sisa) atas.push(['Lainnya', sisa]);
    const kolom = atas.map(([k, n], i) => {
      const lebar = Math.max(n, total * 0.12);
      return `<div class="pill-col" style="flex:${lebar} 1 0"><span class="pill-label">${esc(k)}</span><div class="pill p${i}">${Math.round((n / total) * 100)}%</div></div>`;
    });
    return `<div class="judul">Sebaran layanan per kategori</div><div class="pills">${kolom.join('')}</div>`;
  }

  muatData(
    (d) => {
      const bagi = (t: string) => { const k = String(t).trim().split(/\s+/); const b = k.pop() ?? ''; return [k.join(' '), b]; };
      const [nk, nb] = bagi(d.situs.nama), [dk, db] = bagi(d.situs.daerah);
      el('h-judul').innerHTML = `<span class="kiri"><small>${esc(nk)}</small> <b>${esc(nb)}</b></span> <span class="kanan"><small>${esc(dk)}</small> <b>${esc(db)}</b></span>`;
      el('h-tagline').textContent = d.situs.tagline;
      el('sebaran').innerHTML = sebaran(d);
      // Tombol Pengaduan: tautan diisi admin di Pengaturan (kunci pengaduanLink).
      const ad = el('b-aduan') as HTMLAnchorElement;
      if (d.situs.pengaduanLink) { ad.href = d.situs.pengaduanLink; ad.target = '_blank'; ad.rel = 'noopener'; }

      el('jam').innerHTML = `<h3>Jam layanan</h3><table>${d.situs.jam
        .map((j) => `<tr><td>${esc(j.hari)}</td><td>${esc(j.jam)}</td></tr>`)
        .join('')}</table><p style="margin-top:16px"><a class="btn alt" href="/kontak">Lokasi &amp; kontak</a></p>`;

      el('capaian').innerHTML = d.situs.capaian.map((c, i) => {
        const titik = Array.from({ length: 50 }, (_, k) => {
          const idx = (4 - Math.floor(k / 10)) * 10 + (k % 10); // isi dari baris bawah
          return idx < c.titik ? `<i class="on" style="--k:${idx}"></i>` : '<i></i>';
        }).join('');
        return `<div class="kpi k${i % 4}" data-g="kpi" style="--i:${i}"><b>${c.nilai.toLocaleString('id-ID')}${c.satuan ? ' <em>' + esc(c.satuan) + '</em>' : ''}</b><span>${esc(c.label)}</span>` +
          `<div class="dots" style="--n:${c.titik}" role="img" aria-label="${esc(c.label)}: ${esc(c.skala)}">${titik}</div><small>${esc(c.skala)}</small>${c.tautan ? `<a class="lnk" href="${esc(c.tautan)}">Beri penilaian →</a>` : ''}</div>`;
      }).join('');

      const unggulan = d.layanan.filter((l) => l.unggulan);
      const tampil = (unggulan.length ? unggulan : d.layanan).slice(0, 6);
      el('layanan').innerHTML = tampil.length ? tampil.map((l, j) => `<a class="tile" data-g data-gr="1,0.7" style="--i:${j % 3}" href="/layanan/detail?id=${encodeURIComponent(l.id)}">${IKON_DOK}<span><b>${esc(l.nama)}</b><small>${esc([l.instansi, l.waktu].filter((x) => x && x !== '-').join(' · '))}</small></span></a>`).join('') : '<p class="meta">Belum ada layanan.</p>';

      el('instansi').innerHTML = d.instansi.length
        ? d.instansi.map((i, j) => `<div class="tile" data-g data-gr="1,0.7" style="--i:${j % 3};--s:${j % 2 ? -1 : 1}">${IKON_GEDUNG}<span><b>${esc(i.nama)}</b>${i.loket ? `<small>${esc(i.loket)}</small>` : ''}</span></div>`).join('')
        : '<p class="meta">Belum ada instansi.</p>';

      const terbaru = d.berita.slice(0, 3);
      el('berita').innerHTML = terbaru.length
        ? terbaru.map((b, j) => {
            const gb = String((b as any).gambar || '').trim();
            const foto = gb
              ? `<div class="nw-img"><img src="${esc(gb)}" alt="" loading="lazy" onerror="this.parentNode.classList.add('kosong');this.remove()" /></div>`
              : '<div class="nw-img kosong"></div>';
            return `<a class="nw" data-g data-gr="1,0.65" style="--i:${j};--s:${j % 2 ? -1 : 1}" href="/berita/detail?id=${encodeURIComponent(b.id)}">${foto}` +
              `<div class="nw-body"><time class="nw-tgl">${esc(tanggalIndo(b.tanggal))}</time><h3>${esc(b.judul)}</h3></div>` +
              `<div class="nw-foot"><span>Baca selengkapnya</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div></a>`;
          }).join('')
        : '<p class="meta">Belum ada berita.</p>';
    },
    () => { el('layanan').innerHTML = pesanGagal; },
  );

  mulaiGulir();
</script>
