---
import Base from '../layouts/Base.astro';
---
<Base title="Kontak & lokasi" description="Alamat, jam layanan, dan kontak Mal Pelayanan Publik.">
  <div class="wrap">
    <div class="page-head"><h1>Kontak &amp; lokasi</h1></div>
    <div class="cols" id="kontak"><p class="meta">Memuat…</p></div>
    <div id="aduan"></div>
    <section class="card nilai" id="nilai">
      <h3>Bagaimana pelayanan kami?</h3>
      <p>Penilaian Anda membantu kami meningkatkan mutu pelayanan. Dapat dikirim satu kali per hari.</p>
      <div class="opsi" id="opsi">
        <button type="button" data-n="1"><span aria-hidden="true">😞</span>Tidak baik</button>
        <button type="button" data-n="2"><span aria-hidden="true">😐</span>Kurang baik</button>
        <button type="button" data-n="3"><span aria-hidden="true">🙂</span>Baik</button>
        <button type="button" data-n="4"><span aria-hidden="true">😄</span>Sangat baik</button>
      </div>
      <p class="meta" id="nilai-info" role="status" aria-live="polite"></p>
    </section>
  </div>
  <script>
    import { muatData, esc, paragraf, pesanGagal, API_URL } from '../lib/data';

    const el = document.getElementById('kontak')!;
    const ad = document.getElementById('aduan')!;
    const aman = (u: string) => (/^https?:\/\//i.test(u) ? u : '#');

    // Penilaian kepuasan: satu kali per browser per hari; penanda disimpan setelah server membalas sukses.
    const info = document.getElementById('nilai-info')!;
    const tombol = Array.from(document.querySelectorAll<HTMLButtonElement>('#opsi button'));
    const hari = new Date().toISOString().slice(0, 10);
    const kunci = (() => { try { return localStorage.getItem('mpp-nilai'); } catch { return null; } })();
    const kunci_ = (v: boolean) => tombol.forEach((t) => (t.disabled = v));
    if (kunci === hari) { kunci_(true); info.textContent = 'Terima kasih, penilaian Anda hari ini sudah tercatat.'; }
    tombol.forEach((t) =>
      t.addEventListener('click', async () => {
        kunci_(true);
        info.textContent = 'Mengirim…';
        try {
          const r = await fetch(API_URL.replace('api=1', 'nilai=' + t.dataset.n));
          const j = await r.json();
          if (!j || !j.ok) throw new Error('gagal');
          try { localStorage.setItem('mpp-nilai', hari); } catch { /* abaikan */ }
          const k = j.kepuasan || {};
          info.textContent = 'Terima kasih atas penilaian Anda!' + (k.jumlah ? ` Indeks kepuasan saat ini ${Number(k.indeks).toLocaleString('id-ID')} dari ${Number(k.jumlah).toLocaleString('id-ID')} penilaian.` : '');
        } catch {
          kunci_(false);
          info.textContent = 'Penilaian belum terkirim. Coba lagi sebentar lagi.';
        }
      }),
    );

    muatData(
      (d) => {
        const s = d.situs;
        el.innerHTML = `
          <div class="card"><h3>Alamat</h3>${paragraf(s.alamat)}
            <p style="margin-top:12px"><a class="btn alt" href="${esc(aman(s.petaLink))}" target="_blank" rel="noopener">Petunjuk arah</a></p></div>
          <div class="card"><h3>Jam layanan</h3>
            <table>${s.jam.map((j) => `<tr><td>${esc(j.hari)}</td><td>${esc(j.jam)}</td></tr>`).join('')}</table></div>
          <div class="card"><h3>Hubungi kami</h3>
            <p>Telepon: <a href="tel:${esc(s.telepon.replace(/[^+\d]/g, ''))}">${esc(s.telepon)}</a></p>
            <p>WhatsApp: <a href="https://wa.me/${esc(s.whatsapp.replace(/\D/g, ''))}" target="_blank" rel="noopener">Kirim pesan</a></p>
            <p>Email: <a href="mailto:${esc(s.email)}">${esc(s.email)}</a></p></div>`;

        // Kartu pengaduan: barcode (diunggah admin) + tombol.
        const foto = s.barcode ? `<img class="qr" src="${esc(s.barcode)}" alt="Barcode formulir pengaduan" width="180" height="180" />` : '';
        ad.innerHTML = s.pengaduanLink
          ? `<div class="card aduan${foto ? '' : ' tanpa'}">${foto}<div><h3>Pengaduan &amp; konsultasi</h3>
              <p>Sampaikan pengaduan atau masukan layanan secara online${foto ? ', atau pindai barcode di samping dengan kamera ponsel' : ''}.</p>
              <p style="margin-top:14px"><a class="btn" href="${esc(s.pengaduanLink)}" target="_blank" rel="noopener">${esc(s.pengaduanTeks)}</a></p></div></div>`
          : '';
      },
      () => { el.innerHTML = pesanGagal; },
    );
  </script>
</Base>
