---
import Base from '../layouts/Base.astro';
---
<Base title="Capaian" description="Capaian dan indikator kinerja Mal Pelayanan Publik.">
  <div class="wrap">
    <div class="page-head"><h1>Capaian</h1><p>Indikator kinerja yang diperbarui secara berkala.</p></div>
    <div class="grid" id="list"><p class="meta">Memuat…</p></div>
  </div>
  <script>
    import { muatData, esc, pesanGagal } from '../lib/data';

    const list = document.getElementById('list')!;
    muatData(
      (d) => {
        list.innerHTML = d.situs.capaian
          .map((c) => `<div class="card stat"><b>${c.nilai.toLocaleString('id-ID')}${c.satuan ? ' ' + esc(c.satuan) : ''}</b><span>${esc(c.label)}</span></div>`)
          .join('');
      },
      () => { list.innerHTML = pesanGagal; },
    );
  </script>
</Base>
