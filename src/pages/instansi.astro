---
import Base from '../layouts/Base.astro';
---
<Base title="Instansi">
  <div class="wrap">
    <section class="page-head">
      <h1>Instansi</h1>
      <p>Instansi yang melayani di MPP.</p>
    </section>
    <div class="nw-grid" id="daftar"><p class="meta">Memuat…</p></div>
  </div>

  <dialog id="dlg" class="modal" aria-labelledby="dlg-judul">
    <div class="modal-head">
      <span class="ins-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16M15 9h4a1 1 0 0 1 1 1v11M2 21h20M8 8h3M8 12h3M8 16h3"/></svg></span>
      <div class="modal-ttl"><h2 id="dlg-judul"></h2><p id="dlg-sub"></p></div>
      <button class="modal-x" type="button" id="dlg-x" aria-label="Tutup"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
    <div class="modal-body" id="dlg-isi"></div>
    <div class="modal-foot"><a class="btn" href="/layanan">Lihat semua layanan</a></div>
  </dialog>
</Base>

<script>
  import { muatData, esc, pesanGagal } from '../lib/data';

  const el = (id: string) => document.getElementById(id)!;
  const norm = (s: unknown) => String(s ?? '').trim().toLowerCase();
  const ada = (s: unknown) => { const t = String(s ?? '').trim(); return t && t !== '-' ? t : ''; };
  const dlg = el('dlg') as HTMLDialogElement;

  const GEDUNG = '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16M15 9h4a1 1 0 0 1 1 1v11M2 21h20M8 8h3M8 12h3M8 16h3"/></svg>';
  const TELP = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>';
  const PANAH = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';

  let daftar: any[] = [];
  let layananDari: (nama: string) => any[] = () => [];

  function buka(i: number) {
    const ins = daftar[i];
    const ls = layananDari(ins.nama);
    el('dlg-judul').textContent = ins.nama;
    el('dlg-sub').textContent = `${ls.length} layanan di instansi ini`;
    el('dlg-isi').innerHTML = ls.map((l: any) => {
      const chip = [
        ada(l.kategori) ? `<span class="mtag">${esc(l.kategori)}</span>` : '',
        ada(l.waktu) ? `<span class="mchip">Waktu: ${esc(l.waktu)}</span>` : '',
        ada(l.biaya) ? `<span class="mchip">Biaya: ${esc(l.biaya)}</span>` : '',
      ].join('');
      return `<a class="mrow" href="/layanan/detail?id=${encodeURIComponent(l.id)}"><div><b>${esc(l.nama)}</b>${ada(l.ringkas) ? `<p>${esc(l.ringkas)}</p>` : ''}${chip ? `<div class="mchips">${chip}</div>` : ''}</div>${PANAH}</a>`;
    }).join('');
    dlg.showModal();
    (el('dlg-isi').parentElement as HTMLElement).scrollTop = 0;
    el('dlg-isi').scrollTop = 0;
  }

  muatData(
    (d) => {
      daftar = [...d.instansi].sort(
        (a: any, b: any) => (Number(a.urutan) || 999) - (Number(b.urutan) || 999) || String(a.nama).localeCompare(String(b.nama)),
      );
      layananDari = (nama) => d.layanan.filter((l: any) => norm(l.instansi) === norm(nama));
      if (!daftar.length) { el('daftar').innerHTML = '<p class="meta">Belum ada instansi.</p>'; return; }
      el('daftar').innerHTML = daftar.map((i: any, idx: number) => {
        const n = layananDari(i.nama).length;
        const loket = ada(i.loket);
        const telp = ada(i.telepon);
        const desk = ada(i.deskripsi);
        return `<div class="nw ins">` +
          `<div class="ins-top"><span class="ins-ico">${GEDUNG}</span><div class="ins-ttl"><h3>${esc(i.nama)}</h3>${loket ? `<span class="ins-loket">${esc(loket)}</span>` : ''}</div></div>` +
          `<div class="nw-body">${desk ? `<p class="ins-desk">${esc(desk)}</p>` : ''}${telp ? `<p class="ins-telp">${TELP}${esc(telp)}</p>` : ''}</div>` +
          (n
            ? `<button type="button" class="nw-foot ins-buka" data-i="${idx}" aria-haspopup="dialog"><span>${n} layanan</span><span class="ins-lihat">Lihat daftar${PANAH}</span></button>`
            : `<div class="nw-foot ins-kosong"><span>Belum ada layanan</span></div>`) +
          `</div>`;
      }).join('');
    },
    () => { el('daftar').innerHTML = pesanGagal; },
  );

  el('daftar').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-i]') as HTMLElement | null;
    if (b) buka(Number(b.dataset.i));
  });
  el('dlg-x').addEventListener('click', () => dlg.close());
  // Klik di luar kotak (area gelap) menutup.
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
