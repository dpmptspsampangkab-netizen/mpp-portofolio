---
import Base from '../layouts/Base.astro';
---
<Base title="Instansi" description="Instansi yang melayani di Mal Pelayanan Publik.">
  <div class="wrap">
    <div class="page-head"><h1>Instansi</h1><p>Instansi yang melayani di MPP.</p></div>
    <div class="grid" id="list"><p class="meta">Memuat…</p></div>
  </div>
  <script>
    import { muatData, esc, paragraf, pesanGagal } from '../lib/data';

    const list = document.getElementById('list')!;
    const norm = (s: string) => s.trim().toLowerCase();

    muatData(
      (d) => {
        list.innerHTML = d.instansi.length
          ? d.instansi.map((i) => {
              const n = d.layanan.filter((l) => norm(l.instansi) === norm(i.nama)).length;
              return `<div class="card">${i.loket ? `<span class="tag">${esc(i.loket)}</span>` : ''}<h3>${esc(i.nama)}</h3>${paragraf(i.deskripsi)}${i.telepon ? `<p>Telp. ${esc(i.telepon)}</p>` : ''}<p>${n} layanan</p></div>`;
            }).join('')
          : '<p class="meta">Belum ada instansi.</p>';
      },
      () => { list.innerHTML = pesanGagal; },
    );
  </script>
</Base>
