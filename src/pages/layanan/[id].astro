---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  return (await getCollection('layanan')).map((e) => ({ params: { id: e.id }, props: { e } }));
}
const { e } = Astro.props;
const { Content } = await render(e);
const d = e.data;
---
<Base title={d.nama} description={d.ringkas}>
  <div class="wrap prose">
    <div class="page-head"><span class="tag">{d.kategori}</span><h1>{d.nama}</h1><p>{d.ringkas}</p></div>
    <div class="card" style="margin-bottom:16px"><table>
      <tr><th>Instansi</th><td>{d.instansi}</td></tr>
      <tr><th>Biaya</th><td>{d.biaya}</td></tr>
      <tr><th>Waktu proses</th><td>{d.waktu}</td></tr>
    </table></div>
    <h2>Syarat</h2><ul>{d.syarat.map((s) => <li>{s}</li>)}</ul>
    <h2>Alur</h2><ol>{d.alur.map((s) => <li>{s}</li>)}</ol>
    <Content />
    <p class="meta">Diperbarui {d.diperbarui.toLocaleDateString('id-ID', { dateStyle: 'long' })}</p>
    <p><a class="btn alt" href="/layanan">← Semua layanan</a></p>
  </div>
</Base>
