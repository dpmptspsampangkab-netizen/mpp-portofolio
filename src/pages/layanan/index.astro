---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/ServiceCard.astro';
const layanan = (await getCollection('layanan')).sort((a, b) => a.data.nama.localeCompare(b.data.nama, 'id'));
const kategori = [...new Set(layanan.map((l) => l.data.kategori))].sort();
---
<Base title="Layanan" description="Daftar layanan di Mal Pelayanan Publik beserta syarat dan alurnya.">
  <div class="wrap">
    <div class="page-head"><h1>Layanan</h1><p>Cari layanan, lihat syarat dan alurnya.</p></div>
    <div class="tools">
      <input type="search" id="q" placeholder="Cari layanan, mis. KK, NIB…" aria-label="Cari layanan" />
      <select id="k" aria-label="Kategori"><option value="">Semua kategori</option>{kategori.map((k) => <option>{k}</option>)}</select>
    </div>
    <div class="grid" id="list">{layanan.map((l) => <ServiceCard {...l} />)}</div>
    <p class="empty" id="empty">Tidak ada layanan yang cocok.</p>
  </div>
  <script>
    const q = document.getElementById('q') as HTMLInputElement, k = document.getElementById('k') as HTMLSelectElement;
    const cards = [...document.querySelectorAll<HTMLElement>('.svc')], empty = document.getElementById('empty')!;
    function f() {
      const t = q.value.trim().toLowerCase(); let n = 0;
      cards.forEach((c) => { const ok = (!t || c.dataset.q!.includes(t)) && (!k.value || c.dataset.k === k.value); c.style.display = ok ? '' : 'none'; if (ok) n++; });
      empty.style.display = n ? 'none' : 'block';
    }
    q.addEventListener('input', f); k.addEventListener('change', f);
  </script>
</Base>
