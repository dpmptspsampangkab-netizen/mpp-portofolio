---
import Base from '../../layouts/Base.astro';
---
<Base title="Detail layanan" description="Syarat dan alur layanan di Mal Pelayanan Publik.">
  <div class="wrap" id="konten"><p class="meta">Memuat…</p></div>
  <script>
    import { muatData, esc, tanggalIndo, paragraf, tebal, pesanGagal } from '../../lib/data';

    const id = new URLSearchParams(location.search).get('id') ?? '';
    const isi = document.getElementById('konten')!;
    const kembali = '<a class="btn alt" href="/layanan">← Semua layanan</a>';

    muatData(
      (d, segar) => {
        const l = d.layanan.find((x) => x.id === id);
        if (!l) {
          if (segar) isi.innerHTML = `<div class="page-head"><h1>Layanan tidak ditemukan</h1></div><div class="row">${kembali}</div>`;
          return;
        }
        document.title = `${l.nama} — ${d.situs.nama}`;
        // Alur: baris judul (**Judul**) dan penjelasan di bawahnya menjadi satu langkah.
        const langkah = (a: string[]) => {
          const hasil: { judul: boolean; html: string }[] = [];
          a.forEach((s) => {
            const judul = /^\*\*(?:(?!\*\*).)+\*\*\s*:?$/.test(s);
            const akhir = hasil[hasil.length - 1];
            if (!judul && akhir?.judul) akhir.html += `<span class="ket">${tebal(s)}</span>`;
            else hasil.push({ judul, html: tebal(s) });
          });
          return hasil.map((x) => x.html);
        };
        const poin = (a: string[], urut: boolean) => a.length
          ? `<${urut ? 'ol' : 'ul'} class="poin${urut ? ' urut' : ''}">${(urut ? langkah(a) : a.map(tebal)).map((h) => `<li>${h}</li>`).join('')}</${urut ? 'ol' : 'ul'}>`
          : '<p class="meta">Belum diisi.</p>';
        isi.innerHTML = `
          <div class="page-head"><span class="tag">${esc(l.kategori)}</span><h1>${esc(l.nama)}</h1><p>${esc(l.ringkas)}</p></div>
          <div class="detail">
            <div class="utama">
              <section class="card"><h2>Syarat</h2>${poin(l.syarat, false)}</section>
              <section class="card"><h2>Alur</h2>${poin(l.alur, true)}</section>
              ${l.catatan ? `<section class="card catatan"><h2>Catatan</h2>${paragraf(l.catatan)}</section>` : ''}
            </div>
            <aside class="card dark info">
              <h3>Informasi</h3>
              <dl>
                <dt>Instansi</dt><dd>${esc(l.instansi || '-')}</dd>
                <dt>Biaya</dt><dd>${esc(l.biaya)}</dd>
                <dt>Waktu proses</dt><dd>${esc(l.waktu)}</dd>
              </dl>
              ${l.diperbarui ? `<p class="meta">Diperbarui ${esc(tanggalIndo(l.diperbarui))}</p>` : ''}
            </aside>
          </div>
          <div class="row">${kembali}</div>`;
      },
      () => { isi.innerHTML = pesanGagal; },
    );
  </script>
</Base>
