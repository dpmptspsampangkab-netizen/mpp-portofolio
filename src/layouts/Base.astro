---
import '../styles/global.css';
import '../styles/aturan-tabel.css';
import '../styles/lebar.css';
import site from '../data/site.json';
interface Props { title?: string; description?: string }
const { title, description = site.tagline } = Astro.props;
const full = title ? `${title} | ${site.singkat} ${site.daerah}` : `${site.nama} ${site.daerah}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  ['/', 'Beranda'], ['/tentang', 'Tentang'], ['/layanan', 'Layanan'], ['/instansi', 'Instansi'],
  ['/capaian', 'Capaian'], ['/galeri', 'Galeri'], ['/berita', 'Berita'], ['/kontak', 'Kontak'],
];
const active = (h: string) => (h === '/' ? path === '/' : path === h || path.startsWith(h + '/'));
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <script is:inline>
    // Pasang wallpaper terakhir secepat mungkin agar tidak berkedip.
    try { var w = localStorage.getItem('mpp-wp'); if (w) document.documentElement.style.setProperty('--wp', 'url("' + w + '")'); } catch (e) {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
</head>
<body>
  <a class="skip" href="#isi">Lewati ke konten</a>
  <div class="shell">
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/"><img src={site.logo} alt="" /><span>{site.nama}<small>{site.daerah}</small></span></a>
        <script is:inline define:vars={{ bawaan: site.logo }}>
          // Pasang logo unggahan terakhir secepat mungkin agar tidak berkedip.
          window.pasangLogo = function (u) {
            var img = document.querySelector('.brand img'), ikon = document.querySelector('link[rel="icon"]');
            if (!img) return;
            var khusus = !!u && u !== bawaan;
            img.onerror = function () { img.onerror = null; img.classList.remove('logo-unggah'); img.src = bawaan; };
            img.classList.toggle('logo-unggah', khusus);
            if (img.getAttribute('src') !== (u || bawaan)) img.src = u || bawaan;
            if (ikon && khusus) { ikon.removeAttribute('type'); ikon.href = u; }
            else if (ikon) { ikon.type = 'image/svg+xml'; ikon.href = '/favicon.svg'; }
          };
          try { var l = localStorage.getItem('mpp-logo'); if (l) window.pasangLogo(l); } catch (e) {}
        </script>
        <button class="menu-btn" id="mb" aria-expanded="false" aria-controls="nv">Menu</button>
        <nav id="nv" aria-label="Utama">
          <ul>{nav.map(([h, t]) => <li><a href={h} aria-current={active(h) ? 'page' : undefined}>{t}</a></li>)}</ul>
        </nav>
      </div>
    </header>
    <main id="isi"><slot /></main>
    <footer class="site"><div class="wrap" id="ft">
      <strong>{site.nama} {site.daerah}</strong><br />{site.alamat}<br />
      © {new Date().getFullYear()} {site.nama} {site.daerah}
    </div></footer>
  </div>
  <script>
    import { muatData, esc, ambilWallpaper, API_URL } from '../lib/data';
    // Menu "Aturan" (dropdown kategori) disisipkan otomatis setelah menu Instansi.
    import '../lib/menuAturan';

    const b = document.getElementById('mb'), n = document.getElementById('nv');
    b?.addEventListener('click', () => { const o = n!.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });

    // Hitung kunjungan: sekali per browser per hari; tidak menghitung saat pengembangan lokal.
    // Penanda hari baru disimpan setelah server memastikan hitungan masuk.
    try {
      const hari = new Date().toISOString().slice(0, 10);
      if (!/^(localhost|127\.|\[?::1)/.test(location.hostname) && localStorage.getItem('mpp-hit') !== hari && !sessionStorage.getItem('mpp-hit-wip')) {
        sessionStorage.setItem('mpp-hit-wip', '1');
        fetch(API_URL.replace('api=1', 'hit=1'), { keepalive: true })
          .then((r) => r.json())
          .then((j) => { if (j && j.ok) localStorage.setItem('mpp-hit', hari); })
          .catch(() => {})
          .finally(() => { try { sessionStorage.removeItem('mpp-hit-wip'); } catch { /* abaikan */ } });
      }
    } catch { /* abaikan */ }

    // Nama situs, daerah, dan alamat di header/footer mengikuti Pengaturan di admin.
    muatData((d) => {
      const wp = ambilWallpaper(d.situs.wallpaper);
      try {
        if (wp) { document.documentElement.style.setProperty('--wp', `url("${wp}")`); localStorage.setItem('mpp-wp', wp); }
        else { document.documentElement.style.removeProperty('--wp'); localStorage.removeItem('mpp-wp'); }
      } catch { /* abaikan */ }
      (window as any).pasangLogo?.(d.situs.logo);
      try {
        if (d.situs.logo.startsWith('https://')) localStorage.setItem('mpp-logo', d.situs.logo);
        else localStorage.removeItem('mpp-logo');
      } catch { /* abaikan */ }
      const sp = document.querySelector('.brand span');
      if (sp) {
        if (sp.firstChild) sp.firstChild.nodeValue = d.situs.nama;
        const sm = sp.querySelector('small');
        if (sm) sm.textContent = d.situs.daerah;
      }
      const ft = document.getElementById('ft');
      if (ft) {
        ft.innerHTML = `<strong>${esc(d.situs.nama)} ${esc(d.situs.daerah)}</strong><br />${esc(d.situs.alamat)}<br />© ${new Date().getFullYear()} ${esc(d.situs.nama)} ${esc(d.situs.daerah)}`;
      }
    });
  </script>
</body>
</html>
